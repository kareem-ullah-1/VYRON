NODE_ENV=development
PORT=5122
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pso?schema=public"
# Required, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=8
BCRYPT_ROUNDS=12
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind one reverse proxy (nginx, Cloudflare tunnel, ngrok)
TRUST_PROXY=0
# false: only the very first account (bootstrap admin) or an Admin can register users
ALLOW_PUBLIC_SIGNUP=false
# Public portfolio/demo mode: ON by default - the frontend signs every visitor in automatically
# (POST /Auth/demo-login, no password, auto-creates a reserved demo@portfolio.local Admin account
# on first use) so the login screen never shows. Anyone with the link can do whatever that account
# can do (including deletes) - that's fine for a portfolio demo, but set DEMO_MODE=false if you
# ever deploy this for a real client/business and want real login enforced again.
DEMO_MODE=true
# Optional: point demo-login at a specific existing account instead of the auto-created one.
DEMO_USER_EMAIL=
APP_TIMEZONE=Asia/Karachi
# Optional; defaults to the request host for local uploads
PUBLIC_BASE_URL=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Leave R2_PUBLIC_URL blank for a PRIVATE bucket: images are served via GET /api/files/<key>.
# Set it only if the bucket has a public domain (r2.dev or custom).
R2_PUBLIC_URL=
# Used only by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to false to skip the demo categories/products/customers in `npm run seed`
SEED_SAMPLE_DATA=true
