generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Manager
  Cashier
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(Cashier)
  isActive     Boolean  @default(true)
  avatarKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Attribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  type      String   @default("Option")
  values    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variantAttributes ProductVariantAttribute[]
}

model Product {
  id                Int       @id @default(autoincrement())
  productName       String
  romanUrduName     String?
  description       String    @default("")
  productCode       String    @unique
  productBarCode    String?
  categoryId        Int
  lowStockThreshold Int       @default(10)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([productBarCode])
  @@index([deletedAt])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  key       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        Int       @id @default(autoincrement())
  productId Int
  price     Decimal   @db.Decimal(12, 2)
  stock     Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes ProductVariantAttribute[]
  stockLogs  StockAdjustmentLog[]
  saleItems  SaleItem[]

  @@index([productId])
}

model ProductVariantAttribute {
  id          Int    @id @default(autoincrement())
  variantId   Int
  attributeId Int
  value       String

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@index([variantId])
  @@index([attributeId])
}

model StockAdjustmentLog {
  id             Int      @id @default(autoincrement())
  variantId      Int
  adjustmentType String
  quantity       Int
  previousStock  Int
  newStock       Int
  reason         String?
  adjustedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, adjustedAt])
}

model Customer {
  id            Int      @id @default(autoincrement())
  fullName      String
  email         String   @default("")
  contactNumber String   @default("")
  fullAddress   String   @default("")
  city          String   @default("")
  state         String   @default("")
  country       String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales        Sale[]
  customOrders CustomOrder[]
}

model Sale {
  id             Int      @id @default(autoincrement())
  customerId     Int?
  customerName   String?
  customerNumber String?
  paymentMethod  String   @default("Cash")
  saleDate       DateTime @default(now())
  totalAmount    Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal  @db.Decimal(12, 2)
  status         String   @default("Completed")
  createdById    String?
  createdAt      DateTime @default(now())

  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@index([customerId])
  @@index([saleDate])
}

model SaleItem {
  id                 Int     @id @default(autoincrement())
  saleId             Int
  productVariantId   Int
  productVariantName String
  quantity           Int
  unitPrice          Decimal @db.Decimal(12, 2)
  discountAmount     Decimal @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productVariantId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @default("")
  phone     String   @default("")
  address   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model RawMaterial {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String   @default("")
  unitOfMeasure        String   @default("")
  currentStockQuantity Decimal  @default(0) @db.Decimal(14, 3)
  attributesJson       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseDetails PurchaseDetail[]
}

model Purchase {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  purchaseDate  DateTime
  totalAmount   Decimal  @db.Decimal(14, 2)
  status        String   @default("Completed")
  invoiceNumber String?
  createdAt     DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  details  PurchaseDetail[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseDetail {
  id               Int     @id @default(autoincrement())
  purchaseId       Int
  rawMaterialId    Int
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  subTotal         Decimal @db.Decimal(14, 2)
  itemSnapshotJson String?

  purchase    Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([rawMaterialId])
}

model CustomOrder {
  id              Int       @id @default(autoincrement())
  orderNumber     String    @unique
  orderType       String
  customerId      Int?
  customerName    String?
  customerContact String?
  customerAddress String?
  staffId         String?
  staffName       String?
  description     String?
  deliveryType    String?
  deliveryDate    DateTime?
  totalAmount     Decimal   @db.Decimal(14, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(14, 2)
  paymentMethod   String?
  status          String    @default("Pending")
  blocks          Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer      Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  statusHistory CustomOrderStatusHistory[]
  payments      CustomOrderPayment[]

  @@index([customerId])
  @@index([status])
}

model CustomOrderStatusHistory {
  id              Int      @id @default(autoincrement())
  orderId         Int
  status          String
  changedAt       DateTime @default(now())
  changedByUserId String?
  changedByName   String?
  note            String?

  order CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CustomOrderPayment {
  id               Int      @id @default(autoincrement())
  orderId          Int
  amount           Decimal  @db.Decimal(14, 2)
  paymentMethod    String
  paidAt           DateTime @default(now())
  receivedByUserId String?
  receivedByName   String?
  note             String?

  order CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
